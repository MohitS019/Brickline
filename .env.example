# Supabase project settings. The anon key is safe for browser use because every
# exposed table is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-publishable-or-anon-key

# Server-only. Add this only to trusted local/server environments and Vercel.
# Never prefix it with NEXT_PUBLIC_ and never expose it to client components.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
BRICKLINE_ADMIN_EMAIL=mohitsonje4@gmail.com

# Configure these as encrypted runtime variables in Sites. Do not commit real
# values. Use long, independent random values for the two secrets.
BRICKLINE_GRANT_SECRET=replace-with-a-long-random-secret
BRICKLINE_DATA_SECRET=replace-with-a-different-long-random-secret

