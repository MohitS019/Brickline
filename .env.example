# Supabase project settings. The publishable key is safe for browser use because every
# exposed table is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me

# Server-only. Add this only to trusted local/server environments and Vercel.
# Never prefix it with NEXT_PUBLIC_ and never expose it to client components.
SUPABASE_SECRET_KEY=sb_secret_replace-me

# One independent random value used to derive separate signing and encryption
# keys. Generate at least 32 random bytes; never use an account password here.
BRICKLINE_APP_SECRET=replace-with-at-least-32-random-characters

