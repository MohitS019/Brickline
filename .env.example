# Public URL of the full Sites-hosted application. Vercel uses this to hand
# protected sign-in, access requests, and project research back to Brickline.
NEXT_PUBLIC_BRICKLINE_APP_URL=https://brickline-b2b-platform.msonje.chatgpt.site

# Configure these as encrypted runtime variables in Sites. Do not commit real
# values. Use long, independent random values for the two secrets.
BRICKLINE_ADMIN_EMAIL=admin@example.com
BRICKLINE_GRANT_SECRET=replace-with-a-long-random-secret
BRICKLINE_DATA_SECRET=replace-with-a-different-long-random-secret

