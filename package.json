{
  "name": "brickline",
  "version": "0.2.0",
  "description": "B2B real-estate intelligence for builders, agents, and clients.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/MohitS019/Brickline.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare:map": "node scripts/copy-maplibre-worker.mjs",
    "predev": "npm run prepare:map",
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "predev:vercel": "npm run prepare:map",
    "dev:vercel": "node scripts/run-vercel.mjs dev",
    "prebuild": "npm run prepare:map",
    "build": "node scripts/run-framework.mjs build",
    "prebuild:vercel": "npm run prepare:map",
    "build:vercel": "node scripts/run-vercel.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "start:vercel": "node scripts/run-vercel.mjs start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern public/maplibre",
    "typecheck": "tsc --noEmit",
    "db:test": "supabase test db"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "d3-geo": "^3.1.1",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^6.11.1",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "supabase": "^2.118.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
